# OpenClaw 敏感配置（绝对不能上传）
openclaw.json
jobs.json
*.env
.env*
config.local.*

# 运行时文件
*.log
*.jsonl
sessions/
.last_deploy_head

# 个人知识库
.kb/

# macOS
.DS_Store
__pycache__/
*.pyc
.coverage
htmlcov/
OpenClaw配置文档*.md
ontology/.audit_metrics.jsonl
# V37.9.148: external_dogfood 的 toy 项目若被就地审计 (run_dogfood.sh 实际跑在 /tmp 副本,
# 此为 in-place 运行的防御性忽略)
examples/external_dogfood/project/ontology/.audit_metrics.jsonl

# Python 打包产物 (V37.9.133 chunk 5 + V37.9.148 build/ 中间产物)
dist/
build/
*.egg-info/

# LaTeX build artifacts — paper PDFs/aux are reproducible from the .tex source
# V37.9.333: 泛化到全部 docs/paper/*/latex/（一物一形，原 silent_failures_taxonomy 专用行的超集）
docs/paper/*/latex/*.pdf
docs/paper/*/latex/*.aux
docs/paper/*/latex/*.log
docs/paper/*/latex/*.out
docs/paper/*/latex/*.synctex.gz

# V37.9.238: status_lock() 伴生锁文件（dev 侧 STATUS_FILE 回退 repo 根时产生；Mac Mini 在 ~/.kb）
status.json.lock

# V37.9.311: 备份归档绝不入库 —— 4.27 的 `openclaw backup create` 无 --output 时写到 CWD,
# cron 的 CWD 是仓库目录, 曾留下 1GB 孤儿档且内含 ~/.openclaw 凭据 (误提交=凭据泄漏)。
# 脚本侧已修 (改在 SSD 的 BACKUP_DIR 内生成), 这里是纵深防御。
*-openclaw-backup.tar.gz
openclaw-backup-*.tar.gz

# V37.9.312: job 运行时状态不入库 —— jobs/<name>/cache/ 存 last_run.json / seen_ids.txt /
# raw/api_*.json 等运行期数据。它们随 job 就地生成, 混进 git 视野会污染 status 且有被
# `git add -A` 误提交的风险。注意: seen_ids.txt 是去重状态, 只忽略不要删除(删了会重推旧内容)。
jobs/*/cache/
